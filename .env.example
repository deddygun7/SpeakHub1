# Environment example file
# Copy this to .env or set these variables in your deployment environment

# Primary database connection used by Drizzle/pg
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Founder(s) nick (comma-separated). Only these nicks will get the Founder role on first registration/login
ADMIN_USERS=demiyan

# Secret for signing JWT tokens (set to a secure random value in production)
JWT_SECRET=replace_this_with_a_strong_secret

# Example: Next.js port (optional)
# PORT=3000
